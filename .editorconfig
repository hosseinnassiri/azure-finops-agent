root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{json,yml,yaml,toml,md}]
indent_size = 2

[*.py]
indent_style = tab

# The YAML spec forbids tabs for indentation (GitHub Actions would fail to parse the workflow).
[*.{yml,yaml}]
indent_style = space
