{
  "mcpServers": {
    "azure": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--isolated",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp",
        "azmcp",
        "server",
        "start",
        "--read-only",
        "--mode",
        "all",
        "--namespace",
        "compute",
        "--namespace",
        "monitor",
        "--namespace",
        "pricing",
        "--namespace",
        "advisor",
        "--namespace",
        "group"
      ],
      "env": {
        "AZURE_MCP_COLLECT_TELEMETRY": "false"
      }
    }
  }
}
